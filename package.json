    "sweep:sepolia": "vitest run tests/live.sweep.test.ts",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
