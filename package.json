{
  "name": "ghostname",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Keep the ENS name. Break the payment graph. Forward privacy for established ENS identities via ERC-5564 stealth addresses.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:sepolia": "vitest run tests/live.sepolia.test.ts",
    "sweep:sepolia": "vitest run tests/live.sweep.test.ts",
    "build:agent": "node scripts/build-mcp.mjs",
    "build:all": "npm run build && npm run build:agent",
    "mcp": "node dist-agent/ghostname-mcp.mjs",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node dist-agent/ghostname-mcp.mjs",
    "cli": "node dist-agent/ghostname.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/curves": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "viem": "^2.21.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@scopelift/stealth-address-sdk": "^1.0.0-beta.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "solc": "^0.8.36",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "bin": {
    "ghostname": "dist-agent/ghostname.mjs",
    "ghostname-mcp": "dist-agent/ghostname-mcp.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
