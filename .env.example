# RPC endpoints. Built-in public defaults (publicnode/drpc/1rpc, with fallback)
# are used when unset; set your own here for demo-day reliability.
VITE_MAINNET_RPC_URL=
VITE_SEPOLIA_RPC_URL=

# Optional fallback RPCs (comma-separated) used if the primary fails.
VITE_MAINNET_RPC_FALLBACKS=
VITE_SEPOLIA_RPC_FALLBACKS=

# Demo configuration (pre-fills inputs only; all calls stay live).
# The Sepolia test identity created for the demo and its announcement scan start.
VITE_DEMO_MAINNET_NAME=skrillah.eth
VITE_DEMO_SEPOLIA_NAME=ghostname-3c7714.eth
VITE_SCAN_START_BLOCK=11612900
VITE_DEMO_PAYMENT_ETH=0.001

# Live end-to-end suite (npm run e2e:sepolia): throwaway TESTNET-ONLY key.
# Never use a key holding real assets. Never commit this file with it set.
SEPOLIA_PRIVATE_KEY=

# P2 — Mobula public-exposure panel.
# Works out of the box with Mobula's keyless demo endpoint (rate-limited).
# For production rates, run a minimal proxy that injects your key server-side
# and point the client at it here (the key must NEVER ship in client code):
VITE_MOBULA_PROXY_URL=
# The API key lives ONLY in your proxy, not in this client build:
MOBULA_API_KEY=
