# RPC endpoints. Public defaults are used when unset; set your own for reliability.
VITE_MAINNET_RPC_URL=https://eth.llamarpc.com
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional fallback RPCs (comma-separated) used if the primary fails.
VITE_MAINNET_RPC_FALLBACKS=
VITE_SEPOLIA_RPC_FALLBACKS=

# P2 (optional) — Mobula public-exposure panel. Keep the key server-side; never
# ship it in client code. Leave unset to disable the panel entirely.
MOBULA_API_KEY=
