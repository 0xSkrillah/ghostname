# RPC endpoints. Built-in public defaults (publicnode/drpc/1rpc, with fallback)
# are used when unset; set your own here for demo-day reliability.
VITE_MAINNET_RPC_URL=
VITE_SEPOLIA_RPC_URL=

# Optional fallback RPCs (comma-separated) used if the primary fails.
VITE_MAINNET_RPC_FALLBACKS=
VITE_SEPOLIA_RPC_FALLBACKS=

# Guarded mainnet mode. OFF by default — the shipped/demo build is Sepolia-only.
# Set to true to ENABLE mainnet writes, which then still require an explicit
# typed per-action confirmation in the UI before any mainnet transaction.
# Only enable for a deliberate mainnet deployment; never for the demo build.
VITE_ENABLE_MAINNET=false

# Demo configuration (pre-fills inputs only; all calls stay live, nothing is
# queried automatically on load).
# VITE_DEMO_MAINNET_NAME: OPTIONAL established mainnet ENS name to pre-fill the
# read-only audit input for a presentation. Leave empty for a neutral build.
# Set it only in your local, uncommitted .env; never commit a personal name.
VITE_DEMO_MAINNET_NAME=
# The controlled Sepolia test identity created for the demo and its announcement scan start.
VITE_DEMO_SEPOLIA_NAME=ghostname-3c7714.eth
VITE_SCAN_START_BLOCK=11612900
VITE_DEMO_PAYMENT_ETH=0.001

# Live suites (npm run e2e:sepolia, npm run sweep:sepolia): throwaway
# TESTNET-ONLY key. Never use a key holding real assets. Never commit it set.
SEPOLIA_PRIVATE_KEY=

# Deployed EIP-7702 sweep executor (pre-fills the /receive sweep panel).
# Defaults to the Sepolia demo deployment; override per network.
VITE_SWEEP_EXECUTOR=

# P2 — Mobula public-exposure panel.
# Works out of the box with Mobula's keyless demo endpoint (rate-limited).
# For production rates, run a minimal proxy that injects your key server-side
# and point the client at it here (the key must NEVER ship in client code):
VITE_MOBULA_PROXY_URL=
# The API key lives ONLY in your proxy, not in this client build:
MOBULA_API_KEY=
